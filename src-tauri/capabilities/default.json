{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core capabilities for the main app window, the dictation chip overlay, and the quick-add window",
  "windows": [
    "main",
    "overlay",
    "quickadd"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:default",
    "core:window:default",
    "core:window:allow-set-size",
    "dialog:default"
  ]
}
